{
  "name": "studio-template-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen \u0026\u0026 tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:visual:update": "playwright test responsive-a11y --update-snapshots",
    "security": "node scripts/security-gate.mjs",
    "security:supabase": "node scripts/check-supabase.mjs",
    "dast": "node scripts/dast.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:quick": "node scripts/verify.mjs --quick",
    "gate:selftest": "node scripts/gate-selftest.mjs",
    "setup:githooks": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.2.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": "\u003e=22.12"
  }
}
