# Copie para .env.local (ignorado pelo git). Nunca coloque credenciais reais neste arquivo.

# Rate limit do formulário de contato (requisições por minuto por IP)
CONTACT_RATE_LIMIT=5

# --- Testes de RLS/autorização Supabase (opcional) ---
# Use somente `supabase start` (local) ou staging autorizado, com usuários de TESTE.
SUPABASE_TEST_URL=http://127.0.0.1:54321
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_USER_A_EMAIL=usuario-a@example.test
SUPABASE_TEST_USER_A_PASSWORD=
SUPABASE_TEST_USER_B_EMAIL=usuario-b@example.test
SUPABASE_TEST_USER_B_PASSWORD=
SUPABASE_RLS_TABLE=
SUPABASE_RLS_OWNER_COLUMN=user_id

# --- DAST em staging (opcional, exige autorização registrada) ---
# DAST_TARGET=https://staging.cliente.com.br
# DAST_ALLOWED_HOSTS=staging.cliente.com.br
# DAST_AUTHORIZED=yes
